<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" import="java.util.*,java.time.*,java.math.*,pe.edu.hotel.Web" %>
<%!
 String e(Object o){return Web.esc(o);} String m(Object o){return Web.money(o);}
 String val(jakarta.servlet.http.HttpServletRequest r,String key){return e(r.getParameter(key));}
%>
<%
 String base=request.getContextPath(), current=(String)request.getAttribute("page");
 List<Map<String,Object>> rooms=(List<Map<String,Object>>)request.getAttribute("rooms"), guests=(List<Map<String,Object>>)request.getAttribute("guests"), bookings=(List<Map<String,Object>>)request.getAttribute("bookings");
 LocalDate today=(LocalDate)request.getAttribute("today");
 Map<String,String> titles=Map.of("panel","Resumen del hotel","reservas","Reservas","habitaciones","Habitaciones","huespedes","Huéspedes","nueva-reserva","Nueva reserva");
 long occupied=bookings.stream().filter(b->"CONFIRMADA".equals(b.get("estado"))&&!LocalDate.parse(b.get("fecha_entrada").toString()).isAfter(today)&&LocalDate.parse(b.get("fecha_salida").toString()).isAfter(today)).map(b->b.get("habitacion_id")).distinct().count();
 long pending=bookings.stream().filter(b->"PENDIENTE".equals(b.get("estado"))).count();
 BigDecimal total=bookings.stream().filter(b->"CONFIRMADA".equals(b.get("estado"))).map(b->(BigDecimal)b.get("total")).reduce(BigDecimal.ZERO,BigDecimal::add);
 String csrf=e(session.getAttribute("csrf"));
%>
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#183c36"><title><%=titles.get(current)%> · Casa Serena Hotel</title><link rel="stylesheet" href="<%=base%>/assets/app.css"><script defer src="<%=base%>/assets/app.js"></script></head>
<body><aside class="sidebar"><a class="brand" href="<%=base%>/panel"><span class="brand-mark">CS</span><span>casa serena<small>HOTEL · GESTIÓN</small></span></a><div class="nav-label">ESPACIO DE TRABAJO</div><nav aria-label="Navegación principal">
<% String[][] nav={{"panel","◫","Vista general"},{"reservas","▤","Reservas"},{"habitaciones","▦","Habitaciones"},{"huespedes","♧","Huéspedes"}}; for(String[] item:nav){ %>
<a class="nav-link <%=current.equals(item[0])?"active":""%>" href="<%=base%>/<%=item[0]%>" <%=current.equals(item[0])?"aria-current=\"page\"":""%>><span aria-hidden="true"><%=item[1]%></span><%=item[2]%><%if(item[0].equals("reservas")){%><b><%=bookings.size()%></b><%}%></a><%}%></nav>
<div class="sidebar-note"><span class="live-dot"></span> Recepción en línea<p>Cada estancia empieza<br>con una buena bienvenida.</p></div><div class="profile"><span class="avatar">RE</span><div>Recepción<small>Prototipo académico · APF1</small></div></div></aside>
<div class="workspace"><header class="topbar"><span>Operaciones <span class="crumb">/</span> <strong><%=titles.get(current)%></strong></span><div class="topbar-right"><span class="date"><%=Web.date(today)%></span><span class="avatar small">RE</span></div></header>
<main><div class="page-heading"><div><p class="eyebrow">CASA SERENA · LIMA, PERÚ</p><h1><%=titles.get(current)%></h1><p class="muted"><%=switch(current){case "panel"->"Una mirada a las estancias, los huéspedes y el día de hoy.";case "reservas"->"Organiza cada llegada y acompaña cada estancia.";case "habitaciones"->"Espacios preparados para una estancia memorable.";case "huespedes"->"Conoce a quienes hacen de nuestro hotel su destino.";default->"Prepara la próxima bienvenida, paso a paso.";}%></p></div><%if(!current.equals("nueva-reserva")){%><a class="button primary" href="<%=base%>/nueva-reserva"><span>＋</span> Nueva reserva</a><%}%></div>
<%if(request.getAttribute("error")!=null){%><div class="alert error" role="alert"><%=e(request.getAttribute("error"))%></div><%} if(session.getAttribute("flash")!=null){%><div class="alert success" role="status"><%=e(session.getAttribute("flash"))%></div><%session.removeAttribute("flash");}%>
<%if(current.equals("panel")){%>
<section class="hero"><div><span class="hero-label">HOSPITALIDAD EN CADA DETALLE</span><h2>Todo listo para<br>una gran estancia.</h2><p>Gestiona tu hotel con claridad.<br>Nosotros te ayudamos a cuidar los detalles.</p><a href="<%=base%>/habitaciones">Explorar habitaciones <span>↗</span></a></div><div class="hotel-art" aria-hidden="true"><div class="sun"></div><div class="arch"><div class="window"></div><div class="bed"></div><div class="pillow p1"></div><div class="pillow p2"></div><div class="blanket"></div></div><div class="plant">✳</div><span class="art-caption">TU PRÓXIMA BIENVENIDA</span></div></section>
<section class="stats" aria-label="Indicadores"><article><div class="stat-label">Habitaciones ocupadas <span>▦</span></div><strong><%=occupied%><small> / <%=rooms.size()%></small></strong><p>Reservas confirmadas para hoy</p></article><article><div class="stat-label">Reservas pendientes <span>◷</span></div><strong><%=pending%></strong><p>Por confirmar en recepción</p></article><article><div class="stat-label">Huéspedes registrados <span>♧</span></div><strong><%=guests.size()%></strong><p>En el directorio del hotel</p></article><article><div class="stat-label">Valor confirmado <span>↗</span></div><strong class="amount"><%=m(total)%></strong><p>Total histórico · no equivale a cobros</p></article></section>
<div class="dashboard-grid"><section class="card"><div class="card-heading"><div><h2>Próximas estancias</h2><p>Reservas activas desde hoy</p></div><a class="text-link" href="<%=base%>/reservas">Ver todas ↗</a></div><%
 var upcoming=bookings.stream().filter(b->!"CANCELADA".equals(b.get("estado"))&&!LocalDate.parse(b.get("fecha_salida").toString()).isBefore(today)).sorted(Comparator.comparing(b->b.get("fecha_entrada").toString())).limit(5).toList();
 if(upcoming.isEmpty()){%><div class="empty"><span class="empty-icon">▤</span><h3>La próxima estancia empieza aquí</h3><p>Aún no hay reservas activas.<br>Registra un huésped y prepara su llegada.</p><a class="button secondary" href="<%=base%>/nueva-reserva">Crear primera reserva</a></div><%}else{for(var b:upcoming){%><div class="stay-row"><span class="avatar"><%=e(b.get("numero"))%></span><div><strong><%=e(b.get("nombre"))%></strong><small><%=Web.date(b.get("fecha_entrada"))%> → <%=Web.date(b.get("fecha_salida"))%></small></div><span class="badge <%=e(b.get("estado"))%>"><%=e(b.get("estado"))%></span></div><%}}%></section><section class="card room-summary"><div class="card-heading"><div><h2>El hotel, hoy</h2><p>Ocupación confirmada</p></div><span>▦</span></div><% for(var r:rooms){boolean busy=bookings.stream().anyMatch(b->b.get("habitacion_id").equals(r.get("id"))&&"CONFIRMADA".equals(b.get("estado"))&&!LocalDate.parse(b.get("fecha_entrada").toString()).isAfter(today)&&LocalDate.parse(b.get("fecha_salida").toString()).isAfter(today));%><div class="room-row"><span class="room-number"><%=e(r.get("numero"))%></span><div><strong><%=e(r.get("tipo"))%></strong><small><%=r.get("capacidad")%> huéspedes</small></div><span class="status-dot <%=busy?"busy":""%>"></span><span class="room-state"><%=busy?"Ocupada":"Libre"%></span></div><%}%><a class="full-link" href="<%=base%>/habitaciones">Ver todas las habitaciones →</a></section></div>
<%}else if(current.equals("habitaciones")){%>
<div class="section-note"><span class="live-dot"></span> <%=rooms.size()%> habitaciones · Tarifas por noche en soles <span>La disponibilidad se valida al reservar.</span></div><section class="rooms-grid"><%for(var r:rooms){%><article class="card room-card"><div class="room-visual type-<%=e(r.get("tipo"))%>"><span>HABITACIÓN <%=e(r.get("numero"))%></span><div class="mini-bed"><i></i><i></i></div><b><%=e(r.get("tipo"))%></b></div><div class="room-content"><div class="room-title"><h2><%=e(r.get("tipo"))%> <%=e(r.get("numero"))%></h2><span class="badge CONFIRMADA"><%=Boolean.TRUE.equals(r.get("habilitada"))?"Habilitada":"No habilitada"%></span></div><p><%=e(r.get("descripcion"))%></p><div class="amenities">♧ Hasta <%=r.get("capacidad")%> huéspedes <span>Wi-Fi incluido</span></div><div class="room-bottom"><strong><%=m(r.get("precio_noche"))%><small> / noche</small></strong><a class="button secondary" href="<%=base%>/nueva-reserva?habitacion=<%=r.get("id")%>">Reservar ↗</a></div></div></article><%}%></section>
<%}else if(current.equals("reservas")){%>
<section class="card"><div class="card-heading"><div><h2>Listado de reservas</h2><p><%=bookings.size()%> resultados encontrados</p></div></div><form class="filters" method="get"><label class="search"><span>⌕</span><input name="q" placeholder="Buscar huésped, documento o reserva…" value="<%=val(request,"q")%>" aria-label="Buscar reservas"></label><select name="estado" aria-label="Estado"><option value="">Todos los estados</option><%for(String s:List.of("PENDIENTE","CONFIRMADA","CANCELADA")){%><option <%=s.equals(request.getParameter("estado"))?"selected":""%>><%=s%></option><%}%></select><button class="button secondary">Filtrar</button><a class="text-link" href="<%=base%>/reservas">Limpiar</a></form>
<%if(bookings.isEmpty()){%><div class="empty"><span class="empty-icon">▤</span><h3>No hay reservas para mostrar</h3><p>Crea una nueva reserva o ajusta los filtros de búsqueda.</p><a class="button primary" href="<%=base%>/nueva-reserva">Nueva reserva</a></div><%}else{%><div class="table-wrap"><table><thead><tr><th>Reserva / huésped</th><th>Habitación</th><th>Estancia</th><th>Total</th><th>Estado</th><th>Acciones</th></tr></thead><tbody><%for(var b:bookings){%><tr><td><strong>#<%=b.get("id")%> · <%=e(b.get("nombre"))%></strong><small><%=e(b.get("documento"))%> · <%=b.get("numero_huespedes")%> huéspedes</small></td><td><%=e(b.get("numero"))%><small><%=e(b.get("tipo"))%></small></td><td><%=Web.date(b.get("fecha_entrada"))%> → <%=Web.date(b.get("fecha_salida"))%><small><%=b.get("noches")%> noches</small></td><td><strong><%=m(b.get("total"))%></strong></td><td><span class="badge <%=e(b.get("estado"))%>"><%=e(b.get("estado"))%></span></td><td><%if(!"CANCELADA".equals(b.get("estado"))){%><form method="post" class="inline-actions"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="state"><input type="hidden" name="id" value="<%=b.get("id")%>"><%if("PENDIENTE".equals(b.get("estado"))){%><button class="link-button" name="estado" value="CONFIRMADA">Confirmar</button><%}%><button class="link-button danger" name="estado" value="CANCELADA" data-confirm="¿Cancelar esta reserva? La habitación volverá a estar disponible.">Cancelar</button></form><%}else{%><span class="muted">Finalizada</span><%}%></td></tr><%}%></tbody></table></div><%}%></section>
<%}else if(current.equals("huespedes")){%>
<div class="guest-grid"><section class="card"><div class="card-heading"><div><h2>Directorio de huéspedes</h2><p><%=guests.size()%> registros encontrados</p></div></div><form class="filters" method="get"><label class="search"><span>⌕</span><input name="q" aria-label="Buscar huéspedes" placeholder="Nombre o documento" value="<%=val(request,"q")%>"></label><button class="button secondary">Buscar</button><a class="text-link" href="<%=base%>/huespedes">Limpiar</a></form><%if(guests.isEmpty()){%><div class="empty"><span class="empty-icon">♧</span><h3>Una bienvenida más personal</h3><p>Registra al primer huésped con el formulario.<br>Sus datos estarán disponibles al reservar.</p></div><%}else{%><div class="table-wrap"><table><thead><tr><th>Huésped</th><th>Documento</th><th>Contacto</th></tr></thead><tbody><%for(var g:guests){%><tr><td><strong><%=e(g.get("nombre"))%></strong></td><td><%=e(g.get("documento"))%></td><td><%=e(g.get("telefono"))%><small><%=e(g.get("email"))%></small></td></tr><%}%></tbody></table></div><%}%></section><section class="card"><div class="card-heading"><div><h2>Registrar huésped</h2><p>Datos de contacto para su estancia</p></div></div><form method="post" class="stack-form"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="guest"><label>Nombre completo<input name="nombre" required minlength="3" maxlength="100" autocomplete="name" placeholder="Nombres y apellidos" value="<%=val(request,"nombre")%>"></label><label>Documento de identidad<input name="documento" required minlength="6" maxlength="15" placeholder="DNI o pasaporte" value="<%=val(request,"documento")%>"></label><label>Teléfono<input name="telefono" required minlength="6" maxlength="20" autocomplete="tel" placeholder="Ej. 987 654 321" value="<%=val(request,"telefono")%>"></label><label>Correo electrónico <span class="optional">(opcional)</span><input name="email" type="email" maxlength="100" autocomplete="email" placeholder="nombre@correo.com" value="<%=val(request,"email")%>"></label><button class="button primary">Guardar huésped</button><p class="form-note">Los campos obligatorios permiten identificar al huésped y coordinar su llegada.</p></form></section></div>
<%}else{%>
<div class="booking-grid"><section class="card"><div class="card-heading"><div><h2><span class="step">01</span> Detalles de la estancia</h2><p>Selecciona al huésped, la habitación y las fechas.</p></div></div><%if(guests.isEmpty()){%><div class="alert info">Primero necesitas registrar un huésped. <a href="<%=base%>/huespedes">Ir a huéspedes →</a></div><%}%><form id="booking-form" method="post" class="stack-form"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="reserve"><label>Huésped<select name="cliente" required><option value="">Seleccionar huésped</option><%for(var g:guests){%><option value="<%=g.get("id")%>" <%=g.get("id").toString().equals(request.getParameter("cliente"))?"selected":""%>><%=e(g.get("nombre"))%> · <%=e(g.get("documento"))%></option><%}%></select></label><a class="text-link add-guest" href="<%=base%>/huespedes">＋ Registrar un nuevo huésped</a><label>Habitación<select id="room" name="habitacion" required><option value="" data-rate="0">Seleccionar habitación</option><%for(var r:rooms){%><option value="<%=r.get("id")%>" data-rate="<%=r.get("precio_noche")%>" data-capacity="<%=r.get("capacidad")%>" <%=r.get("id").toString().equals(request.getParameter("habitacion"))?"selected":""%>><%=e(r.get("numero"))%> · <%=e(r.get("tipo"))%> · <%=m(r.get("precio_noche"))%> / noche</option><%}%></select></label><div class="form-row"><label>Fecha de entrada<input id="entrada" type="text" name="entrada" inputmode="numeric" placeholder="dd/mm/aaaa" pattern="[0-9]{2}/[0-9]{2}/[0-9]{4}" maxlength="10" title="Día/mes/año (dd/mm/aaaa)" value="<%=val(request,"entrada")%>" required></label><label>Fecha de salida<input id="salida" type="text" name="salida" inputmode="numeric" placeholder="dd/mm/aaaa" pattern="[0-9]{2}/[0-9]{2}/[0-9]{4}" maxlength="10" title="Día/mes/año (dd/mm/aaaa)" value="<%=val(request,"salida")%>" required></label></div><label>Número de huéspedes<input id="personas" type="number" name="personas" min="1" max="10" value="<%=request.getParameter("personas")==null?"1":val(request,"personas")%>" required></label><label>Observaciones <span class="optional">(opcional)</span><textarea name="observaciones" rows="3" maxlength="250" placeholder="Preferencias o detalles para preparar la llegada"><%=val(request,"observaciones")%></textarea></label><div class="form-footer"><a class="button secondary" href="<%=base%>/reservas">Volver</a><button class="button primary" <%=guests.isEmpty()?"disabled":""%>>Guardar reserva →</button></div></form></section><aside class="card summary"><div class="card-heading"><div><p class="eyebrow">TU PRÓXIMA ESTANCIA</p><h2>Resumen de reserva</h2></div></div><div class="summary-content"><div class="summary-art">CS<span>CASA SERENA HOTEL</span></div><h3 id="summary-room">Selecciona una habitación</h3><p class="muted">El descanso empieza con los detalles.</p><dl><div><dt>Tarifa por noche</dt><dd id="summary-rate">S/ 0.00</dd></div><div><dt>Noches</dt><dd id="summary-nights">—</dd></div><div><dt>Huéspedes</dt><dd id="summary-people">1</dd></div><div class="summary-total"><dt>Total estimado</dt><dd id="summary-total">S/ 0.00</dd></div></dl><div class="summary-tip"><span>ⓘ</span><p>La reserva se guardará como <strong>pendiente</strong>. La disponibilidad y el importe se validan al guardar.</p></div><p class="form-note">Importes en soles peruanos. No se realiza ningún cobro desde esta aplicación.</p></div></aside></div>
<%}%>
<footer>Casa Serena · Sistema de Gestión y Reservas Hoteleras <span>Desarrollo Web Integrado · APF1 2026</span></footer></main></div></body></html>
